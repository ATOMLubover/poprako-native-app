import React, { useState, useEffect, useRef, useLayoutEffect } from 'react';
import { Loader2, Ruler, LayoutList, AlertCircle } from 'lucide-react';

/**
 * 增强版动态容量计算 Hook
 * 核心公式：(容器可用高度 + 间距) / (条目高度 + 间距)
 * 这样可以精确抵消掉 Flex 布局中 gap 的影响
 */
const useDynamicCapacity = (containerRef, templateRef) => {
  const [capacity, setCapacity] = useState(0);
  const [itemHeight, setItemHeight] = useState(0);

  useLayoutEffect(() => {
    if (!containerRef.current || !templateRef.current) return;

    const calculate = () => {
      const container = containerRef.current;
      const template = templateRef.current;
      
      // 获取浏览器计算后的真实样式
      const style = window.getComputedStyle(container);
      const gap = parseFloat(style.gap) || 0;
      const pt = parseFloat(style.paddingTop) || 0;
      const pb = parseFloat(style.paddingBottom) || 0;
      
      // 计算容器实际可承载内容的净高度
      const containerRect = container.getBoundingClientRect();
      const availableHeight = containerRect.height - pt - pb;
      
      // 获取模板组件的自然高度
      const singleItemHeight = template.getBoundingClientRect().height;
      setItemHeight(singleItemHeight);

      if (singleItemHeight > 0) {
        /**
         * 算法推导：
         * 假设有 n 个元素，总高度 = n * itemHeight + (n-1) * gap
         * 总高度 = n * (itemHeight + gap) - gap
         * 因此 n = (总高度 + gap) / (itemHeight + gap)
         */
        const count = Math.floor((availableHeight + gap + 0.1) / (singleItemHeight + gap));
        setCapacity(Math.max(1, count));
      }
    };

    const observer = new ResizeObserver(calculate);
    observer.observe(containerRef.current);
    // 同时也监听模板，防止模板内部内容变化导致高度变动
    observer.observe(templateRef.current);

    calculate();
    return () => observer.disconnect();
  }, []);

  return { capacity, itemHeight };
};

/**
 * 列表项模板
 * isTemplate 为 true 时，它会作为测量基准，不显示但占据空间用于测量
 */
const MyCustomItem = ({ data, index, isTemplate = false, innerRef }) => (
  <div 
    ref={innerRef}
    className={`p-6 rounded-xl border flex flex-col gap-2 shrink-0 ${
      isTemplate 
        ? 'opacity-0 pointer-events-none absolute w-full' 
        : 'bg-white border-slate-200 shadow-sm'
    }`}
    style={isTemplate ? { visibility: 'hidden', zIndex: -1 } : {}}
  >
    <div className="flex items-center gap-3">
      <div className="w-8 h-8 rounded bg-indigo-500 text-white flex items-center justify-center font-bold">
        {index ?? '?'}
      </div>
      <h3 className="font-bold text-slate-800 truncate">
        {data?.title || '模板标题 - 用于高度测量'}
      </h3>
    </div>
    <p className="text-sm text-slate-600 line-clamp-2">
      {data?.description || '这段描述文本长度应该具有代表性，因为它的换行会直接影响测量出的组件高度。'}
    </p>
  </div>
);

const App = () => {
  const containerRef = useRef(null);
  const templateRef = useRef(null);
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(false);

  const { capacity, itemHeight } = useDynamicCapacity(containerRef, templateRef);

  useEffect(() => {
    if (capacity <= 0) return;

    let isMounted = true;
    const fetchData = async () => {
      setLoading(true);
      // 模拟请求延迟
      await new Promise(r => setTimeout(r, 500));
      
      const mockData = Array.from({ length: capacity }, (_, i) => ({
        id: `item-${i}-${capacity}`, // 包含容量信息作为 ID 确保列表刷新
        title: `动态加载项目 ${i + 1}`,
        description: `这是根据当前容器高度自动计算出的第 ${i + 1} 个项目。`
      }));

      if (isMounted) {
        setItems(mockData);
        setLoading(false);
      }
    };

    fetchData();
    return () => { isMounted = false; };
  }, [capacity]);

  return (
    <div className="h-screen bg-slate-100 p-4 md:p-10 flex flex-col font-sans">
      <div className="max-w-3xl mx-auto w-full flex flex-col h-full gap-4">
        
        {/* 数据展示栏 */}
        <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex justify-between items-center">
          <div className="flex gap-6">
            <div className="flex items-center gap-2">
              <Ruler size={16} className="text-indigo-500" />
              <span className="text-xs font-semibold text-slate-500 uppercase tracking-wider">单项高度</span>
              <span className="text-sm font-bold text-slate-800">{itemHeight.toFixed(1)}px</span>
            </div>
            <div className="flex items-center gap-2 border-l pl-6">
              <LayoutList size={16} className="text-emerald-500" />
              <span className="text-xs font-semibold text-slate-500 uppercase tracking-wider">推荐容量</span>
              <span className="text-sm font-bold text-slate-800">{capacity}</span>
            </div>
          </div>
          {loading && (
            <div className="flex items-center gap-2 text-indigo-400">
              <Loader2 size={18} className="animate-spin" />
              <span className="text-xs font-medium">加载中...</span>
            </div>
          )}
        </div>

        {/* 核心响应式列表容器 */}
        <div 
          ref={containerRef} 
          className="flex-grow bg-white rounded-2xl border border-slate-200 shadow-inner p-4 flex flex-col gap-3 overflow-hidden relative"
        >
          {/* 1. 隐藏的测量模板：放在同一个 flex 容器内以确保 CSS 上下文一致 */}
          <MyCustomItem isTemplate={true} innerRef={templateRef} />

          {/* 2. 实际渲染列表 */}
          {!loading || items.length > 0 ? (
            items.map((item, idx) => (
              <MyCustomItem key={item.id} data={item} index={idx + 1} />
            ))
          ) : null}

          {/* 视觉底部标记 */}
          {items.length > 0 && (
            <div className="mt-auto pt-2 text-[10px] text-slate-300 text-center uppercase tracking-widest pointer-events-none">
              容器底部 - 计算已闭环
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default App;